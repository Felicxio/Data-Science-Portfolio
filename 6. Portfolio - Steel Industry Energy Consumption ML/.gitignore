# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.Python

# Ambientes virtuais
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ============================================
# JUPYTER NOTEBOOK
# ============================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# ============================================
# DATA (IMPORTANTE!)
# ============================================
# Bloquear dados brutos (são grandes)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.zip
data/raw/*.json
data/raw/*.parquet

# Permitir arquivo exemplo pequeno (se tiver)
!data/raw/sample_*.csv

# Bloquear dados processados GRANDES
data/processed/*_large.csv
data/processed/*_full.csv

# ============================================
# MODELS (ARQUIVOS GRANDES!)
# ============================================
# Bloquear TODOS os modelos salvos
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth
models/*.ckpt

# Se quiser subir modelo pequeno de exemplo
!models/example_*.pkl

# ============================================
# REPORTS & OUTPUTS
# ============================================
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.pdf
!reports/figures/.gitkeep

# Arquivos temporários de relatórios
*.log
*.tmp

# ============================================
# IDE / EDITORS
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# ============================================
# OPERATING SYSTEM
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~$*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ============================================
# TESTING & COVERAGE
